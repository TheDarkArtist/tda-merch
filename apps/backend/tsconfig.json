{
  "compilerOptions": {
    "target": "ES2022", // Modern Node support
    "module": "CommonJS", // Node-friendly
    "rootDir": "src", // Your TS source
    "outDir": "dist", // Compiled JS output
    "strict": true, // Enable all strict type checks
    "esModuleInterop": true, // Allow default imports from CJS modules
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, // Skip type checks on node_modules
    "moduleResolution": "node", // Node-style resolution
    "baseUrl": ".", // For path aliases
    "paths": {
      "@/*": ["src/*"] // Use @/ for src folder
    },
    "allowJs": false, // Only TS files
    "resolveJsonModule": true // Import JSON
    // "noUnusedLocals": true,                  // Enforce cleaner code
    // "noUnusedParameters": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
