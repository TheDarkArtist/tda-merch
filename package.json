{
  "name": "tda-merch",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "bun run --filter frontend dev",
    "dev:backend": "bun run --filter backend dev",
    "dev": "concurrently -n frontend,backend -c green,cyan \"bun dev:frontend\" \"bun dev:backend\"",
    "build:frontend": "bun run --filter frontend build",
    "build:backend": "bun run --filter backend build",
    "build": "concurrently -n frontend,backend -c green,cyan \"bun build:frontend\" \"bun build:backend\"",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5"
  }
}
